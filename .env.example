# GeoAI WebGIS Agent configuration
# Copy this file to .env and fill in the values. Never commit .env.

# --- Model provider ----------------------------------------------------------
# Default provider shown in the app. One of: gemini, ollama, groq, openrouter, openai, custom
LLM_PROVIDER=gemini
# Optional: default model for that provider, e.g. gemini-2.5-flash-lite or qwen3:8b
# LLM_MODEL=

# REQUIRED: an API key for at least one provider (Ollama needs none).
# Every provider with a key can be picked in the app.
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Ollama runs locally without a key: LLM_PROVIDER=ollama, LLM_MODEL=qwen3:8b
# Other OpenAI-compatible servers (LM Studio, vLLM): LLM_PROVIDER=custom plus the two lines below
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=
# Raise this if local models time out on CPU (milliseconds)
# LLM_TIMEOUT_MS=120000

# --- Server and agent --------------------------------------------------------
PORT=3000
# Model turns that may call tools before the agent must answer
MAX_AGENT_STEPS=6

# --- OpenStreetMap services --------------------------------------------------
# NOTE: set a contact email before you deploy. Nominatim's usage policy asks for one
# in the User-Agent so the operators can reach you.
CONTACT_EMAIL=
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
